<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget jadwal kajian. Hanya memakai LinearLayout + TextView karena
  RemoteViews tidak mendukung komponen lain.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_latar"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KAJIAN MENDATANG"
        android:textColor="#FBBF24"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/kajian_judul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Jadwal Kajian"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kajian_waktu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text=""
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kajian_ustadz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#B9D9CC"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/kajian_lokasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#B9D9CC"
        android:textSize="10sp" />

    <!-- Pengisi ruang: mendorong baris petunjuk ke dasar widget. Dengan begitu,
         sisa ruang dari ukuran sel launcher terbaca sebagai jarak yang
         disengaja, bukan ruang kosong yang menggantung di bawah. -->
    <TextView
        android:id="@+id/kajian_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="#B9D9CC"
        android:textSize="9sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ketuk untuk lihat semua jadwal"
        android:textColor="#7FA898"
        android:textSize="9sp" />
</LinearLayout>
