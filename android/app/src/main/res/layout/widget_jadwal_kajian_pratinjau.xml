<?xml version="1.0" encoding="utf-8"?>
<!--
  PRATINJAU widget jadwal kajian untuk pemilih widget.

  Hanya contoh berisi data karangan; yang dipakai di layar utama tetap
  `widget_jadwal_kajian.xml`. Lihat catatan di `widget_jadwal_sholat_pratinjau.xml`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_latar"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="KAJIAN MENDATANG"
        android:textColor="#FBBF24"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Pelajaran Praktis dari Kisah Nabi Adam"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="Sel, 20 Okt · 18:35"
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Syaikh Dr. Abul Hasan Ali bin Jadullah"
        android:textColor="#B9D9CC"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Mushalla Insyira"
        android:textColor="#B9D9CC"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="#B9D9CC"
        android:textSize="9sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ketuk untuk lihat semua jadwal"
        android:textColor="#7FA898"
        android:textSize="9sp" />
</LinearLayout>
