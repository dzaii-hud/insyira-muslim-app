<?xml version="1.0" encoding="utf-8"?>
<!--
  Pengaturan widget jadwal sholat.

  `updatePeriodMillis` = 30 menit (nilai terkecil yang diizinkan Android).
  Tujuannya bukan mengambil data baru — datanya sudah tersimpan di perangkat —
  melainkan menyegarkan penanda "sholat berikutnya" dan berganti hari.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_sholat_ket"
    android:initialLayout="@layout/widget_jadwal_sholat"
    android:minHeight="150dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget_sholat_pratinjau"
    android:previewLayout="@layout/widget_jadwal_sholat_pratinjau"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
